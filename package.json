{
  "name": "citygen",
  "version": "0.1.0",
  "description": "Procedural town and city generator for three.js: street networks, blocks, lots, sidewalks, lane markings and buildings.",
  "license": "MIT",
  "author": "hxtnv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxtnv/citygen.git"
  },
  "homepage": "https://hxtnv.github.io/citygen/",
  "bugs": "https://github.com/hxtnv/citygen/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite demo",
    "build": "rm -rf dist && vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build demo",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "screenshots": "node scripts/screenshots.mjs",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "lil-gui": "^0.21.0",
    "playwright": "^1.65.1",
    "three": "0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "keywords": [
    "three",
    "threejs",
    "procedural",
    "city",
    "town",
    "generator",
    "roads",
    "streets",
    "procedural-generation",
    "city-generator",
    "road-network",
    "webgl",
    "gamedev"
  ]
}
